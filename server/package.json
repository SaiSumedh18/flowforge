{
  "name": "flowforge-server",
  "version": "1.0.0",
  "description": "Backend API for FlowForge job scheduling and execution platform",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
